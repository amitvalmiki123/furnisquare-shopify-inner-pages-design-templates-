      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pan India free shipping"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link",
        "settings": {
          "icon": "cash",
          "label": "Cash on Delivery"
        }
      },
      {
        "type": "link",
        "settings": {
          "icon": "pencil",
          "label": "Customization",
          "url": "/pages/bulk-order-customization"
        }
      },
      {
        "type": "link",
        "settings": {
          "icon": "boxes",
          "label": "Buy in Bulk",
          "url": "/pages/bulk-order-customization"
        }
      },
      {
