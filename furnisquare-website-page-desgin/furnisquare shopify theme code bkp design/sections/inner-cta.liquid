{%- comment -%}
  Inner page closing call to action (espresso band).
  Visual reference: mockup .ctaband.
{%- endcomment -%}
<section class="sec" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="wrap">
    <div class="ctaband">
      <div>
        <h2>{{ section.settings.heading | replace: '</p><p>', ' ' | remove: '<p>' | remove: '</p>' }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="ctaband__acts">
          {%- if section.settings.button_1_label != blank -%}
            {%- assign btn1_icon = section.settings.button_1_icon | default: 'arrow' -%}
            <a class="btn btn--saffron" href="{{ section.settings.button_1_link | default: '#' }}">{% if btn1_icon != 'none' %}{% render 'icon', name: btn1_icon %}{% endif %}{{ section.settings.button_1_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            {%- assign btn2_icon = section.settings.button_2_icon | default: 'none' -%}
            <a class="btn btn--line" href="{{ section.settings.button_2_link | default: '#' }}"{% if section.settings.button_2_external %} target="_blank" rel="noopener"{% endif %}>{% if btn2_icon != 'none' %}{% render 'icon', name: btn2_icon %}{% endif %}{{ section.settings.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inner CTA Band",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section label (accessibility)",
      "default": "Next steps"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (H2)",
      "info": "Saffron = wrap text in <em>…</em>",
      "default": "Start creating your <em>home</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": "Solid wood furniture for every room, delivered free across India."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "button_1_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "button_1_icon",
      "label": "Primary button icon",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "phone", "label": "Phone" },
        { "value": "wa", "label": "WhatsApp" },
        { "value": "mail", "label": "Mail" },
        { "value": "none", "label": "No icon" }
      ],
      "default": "arrow"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "button_2_link",
      "label": "Secondary button link",
      "default": "/pages/contact"
    },
    {
      "type": "select",
      "id": "button_2_icon",
      "label": "Secondary button icon",
      "options": [
        { "value": "none", "label": "No icon" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "phone", "label": "Phone" },
        { "value": "wa", "label": "WhatsApp" },
        { "value": "mail", "label": "Mail" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "button_2_external",
      "label": "Open secondary link in a new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Inner CTA Band"
    }
  ]
}
{% endschema %}
