{%- comment -%}
  Inner page enquiry block: "why choose us" list + Shopify contact form (V2 fcard).
  Posts to the store contact inbox as form_type=contact with the same
  contact[...] field names the static mockup used. Anchor id is configurable
  (default #bulk-form) so hero buttons can deep-link to it.
{%- endcomment -%}
{%- liquid
  assign anchor = section.settings.anchor | default: 'bulk-form'
  assign uid = 'f' | append: section.id
  assign title_id = 'why-title-' | append: section.id
  assign form_title_id = 'form-title-' | append: section.id
-%}
<section class="sec sec--tint" id="{{ anchor }}" aria-labelledby="{{ title_id }}">
  <div class="wrap fwrap">
    <div class="fside">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"><span class="sq" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="mast__title" id="{{ title_id }}">{{ section.settings.heading }}</h2>
      {%- if section.blocks.size > 0 -%}
        <ul class="why">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon %}
              <div>
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.text }}</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="fcard">
      <h2 id="{{ form_title_id }}">{{ section.settings.form_heading }}</h2>
      {%- if section.settings.form_intro != blank -%}
        <p class="fcard__intro">{{ section.settings.form_intro }}</p>
      {%- endif -%}

      {%- form 'contact', class: 'enquiry-form', id: uid, accept-charset: 'UTF-8' -%}
        <input type="hidden" name="contact[Request]" value="{{ section.settings.request_tag }}">

        {%- if form.posted_successfully? -%}
          <div class="fdone" tabindex="-1">
            {% render 'icon', name: 'check' %}
            <h3>{{ section.settings.done_heading }}</h3>
            <p>{{ section.settings.done_text }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="fcard__errors" role="alert">
              {%- if section.settings.error_heading != blank -%}<strong>{{ section.settings.error_heading }}</strong>{%- endif -%}
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="fgrid">
            <div class="ff full">
              <label for="{{ uid }}-biz">{{ section.settings.business_label }} {%- if section.settings.business_note != blank %} <span class="opt">{{ section.settings.business_note }}</span>{% endif -%}</label>
              <input id="{{ uid }}-biz" type="text" name="contact[Business Name]" autocomplete="organization">
            </div>
            <div class="ff">
              <label for="{{ uid }}-name">{{ section.settings.name_label }} <i aria-hidden="true">*</i></label>
              <input id="{{ uid }}-name" type="text" name="contact[Full Name]" autocomplete="name" required>
            </div>
            <div class="ff ff--phone">
              <label for="{{ uid }}-wa">{{ section.settings.phone_label }} <i aria-hidden="true">*</i></label>
              <input id="{{ uid }}-wa" type="tel" name="contact[WhatsApp Number]" autocomplete="tel-national" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required>
            </div>
            <div class="ff">
              <label for="{{ uid }}-email">{{ section.settings.email_label }}</label>
              <input id="{{ uid }}-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}">
            </div>
            <div class="ff">
              <label for="{{ uid }}-cat">{{ section.settings.category_label }} <i aria-hidden="true">*</i></label>
              <select id="{{ uid }}-cat" name="contact[Category]" required>
                <option value="" selected disabled>{{ section.settings.category_placeholder }}</option>
                {%- assign category_lines = section.settings.category_options | newline_to_br | split: '<br />' -%}
                {%- for line in category_lines -%}
                  {%- assign option = line | strip -%}
                  {%- if option != blank -%}<option value="{{ option | escape }}">{{ option | escape }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
          </div>
          <div class="fsubmit">
            <button class="btn btn--saffron" type="submit">{{ section.settings.submit_label }} {% render 'icon', name: 'arrow' %}</button>
            {%- if section.settings.submit_note != blank -%}
              <small>{{ section.settings.submit_note }}</small>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.enquiry-form input[type="tel"]').forEach(function (input) {
    input.addEventListener('input', function () {
      input.value = input.value.replace(/\D/g, '').slice(0, 10);
    });
  });
</script>

{% schema %}
{
  "name": "Inner Enquiry Form",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Section id used for deep links (e.g. #bulk-form). Keep lowercase with hyphens.",
      "default": "bulk-form"
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why choose Furnisquare?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "HTML allowed, e.g. <em>elegance</em> for the saffron emphasis.",
      "default": "Premium furniture crafted with quality, comfort & <em>elegance</em>"
    },
    {
      "type": "header",
      "content": "Form card"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Enquiry for bulk orders"
    },
    {
      "type": "textarea",
      "id": "form_intro",
      "label": "Form intro",
      "default": "Our dedicated team will contact you within 24 hours with a customized catalog and quotation."
    },
    {
      "type": "text",
      "id": "request_tag",
      "label": "Request tag (hidden)",
      "info": "Added as contact[Request] in the enquiry email so the team can filter bulk enquiries.",
      "default": "Bulk order enquiry"
    },
    {
      "type": "text",
      "id": "business_label",
      "label": "Business name label",
      "default": "Business name"
    },
    {
      "type": "text",
      "id": "business_note",
      "label": "Business name note",
      "default": "(if applicable)"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Full name / contact person"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "WhatsApp number label",
      "default": "WhatsApp number"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category label",
      "default": "Which category best describes you?"
    },
    {
      "type": "text",
      "id": "category_placeholder",
      "label": "Category placeholder",
      "default": "Select category"
    },
    {
      "type": "textarea",
      "id": "category_options",
      "label": "Category options",
      "info": "One option per line.",
      "default": "Retailer\nWholesaler\nInterior Designer\nArchitect\nHotel\nOffice\nDistributor\nOther"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "submit_note",
      "label": "Submit button note",
      "default": "We reply within 24 hours."
    },
    {
      "type": "text",
      "id": "error_heading",
      "label": "Error box heading",
      "info": "Shown above the field errors when the form is rejected.",
      "default": "Please check the following:"
    },
    {
      "type": "header",
      "content": "Success state"
    },
    {
      "type": "text",
      "id": "done_heading",
      "label": "Thank-you heading",
      "default": "Thank you — enquiry received"
    },
    {
      "type": "textarea",
      "id": "done_text",
      "label": "Thank-you text",
      "default": "Our dedicated team will contact you within 24 hours with a customized catalog and quotation."
    }
  ],
  "blocks": [
    {
      "type": "why_item",
      "name": "Why point",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "info": "Must exist in snippets/icon.liquid (e.g. shield, truck, star, tag).",
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Crafted with durable materials and premium finishing for long-lasting elegance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inner Enquiry Form",
      "blocks": [
        { "type": "why_item", "settings": { "icon": "shield", "title": "Premium Quality", "text": "Crafted with durable materials and premium finishing for long-lasting elegance." } },
        { "type": "why_item", "settings": { "icon": "truck", "title": "Fast Delivery", "text": "Quick and secure delivery service to ensure your furniture reaches safely." } },
        { "type": "why_item", "settings": { "icon": "star", "title": "Modern Designs", "text": "Stylish and modern furniture designs that perfectly match your lifestyle." } },
        { "type": "why_item", "settings": { "icon": "tag", "title": "Affordable Luxury", "text": "Luxury furniture experience at budget-friendly pricing for every home." } }
      ]
    }
  ]
}
{% endschema %}
