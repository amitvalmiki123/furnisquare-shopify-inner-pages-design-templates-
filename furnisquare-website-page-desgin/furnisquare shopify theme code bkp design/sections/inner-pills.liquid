{%- comment -%}
  Inner page pill list with a section head (e.g. "Who we work with").
  Blocks = individual pills. Visual reference: mockup .shead + .pills.
{%- endcomment -%}
{%- liquid
  assign heading_id = 'pills-title-' | append: section.id
-%}
<section class="sec" aria-labelledby="{{ heading_id }}">
  <div class="wrap">
    <header class="shead">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"><span class="sq" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="mast__title" id="{{ heading_id }}">{{ section.settings.heading | replace: '</p><p>', ' ' | remove: '<p>' | remove: '</p>' }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </header>
    {%- if section.blocks.size > 0 -%}
      <ul class="pills">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Pills",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Who we work with"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (H2)",
      "info": "Renders inside <h2>…</h2> (tag is added by the section — do NOT type it). Raw HTML shown and saved as typed. Wrap the saffron part in <em>, e.g. <em>every kind of buyer</em>.",
      "default": "Bulk furniture for <em>every kind of buyer</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Retailers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inner Pills",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "label": "Retailers"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Wholesalers"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Interior Designers"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Architects"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Hotels"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Offices"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Distributors"
          }
        }
      ]
    }
  ]
}
{% endschema %}
