          "label": "Title (H3)",
          "default": "Customer Obsession"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Customers are at the center of whatever we do at Furnisquare."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label (optional)"
        },
        {
          "type": "text",
          "id": "link_url",
          "label": "Link URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inner Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "star",
            "title": "Customer Obsession",
            "text": "Customers are at the center of whatever we do at Furnisquare. We ensure that we get the right customer solution in all our initiatives. We establish a long-term relationship with every customer and aim to delight them in every interaction. We aim to set the global benchmark for customer happiness scores."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "shield",
            "title": "Honesty & Transparency",
            "text": "We are honest, ethical, and trustworthy in the way we live life. We hold the highest standards of corporate governance in all our activities. We communicate transparently with all our stakeholders. When we make mistakes, we are honest and upfront about owning up to them."
          }
