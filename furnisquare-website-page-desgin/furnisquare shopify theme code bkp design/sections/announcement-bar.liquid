{%- liquid
  assign tel = settings.phone | replace: ' ', '' | replace: '-', ''
-%}
<div class="topbar">
  <div class="wrap topbar__in">
    <ul class="topbar__links" aria-label="Shopping services">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}">{% render 'icon', name: block.settings.icon %}{{ block.settings.label }}</a>
            {%- else -%}
              {% render 'icon', name: block.settings.icon %}{{ block.settings.label }}
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="topbar__news" aria-live="polite">
      {%- assign first_msg = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'message' -%}
          <p{% if first_msg %} class="is-on"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- assign first_msg = false -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if settings.phone != blank -%}
      <a class="topbar__phone" href="tel:{{ tel }}">{% render 'icon', name: 'phone' %}{{ settings.phone }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
