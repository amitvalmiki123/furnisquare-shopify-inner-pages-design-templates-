{%- comment -%}
  Inner page — press & media enquiry band. Left: heading + lede.
  Right: quick links (e.g. email / phone / about). Visual reference: mockup .hm__rev
  (press variant on the Media page).
{%- endcomment -%}
<section class="sec{% if section.settings.tinted %} sec--tint{% endif %}" aria-labelledby="press-{{ section.id }}">
  <div class="wrap hm__rev">
    <div>
      <h2 class="mast__title" id="press-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="hm__lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="quick">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{% render 'icon', name: block.settings.icon %}{{ block.settings.label }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Press Band",
  "settings": [
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Cream band background",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H2)",
      "default": "Press and media enquiries"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Writing about Furnisquare? We can share product images, brand details and quotes."
    }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mail", "label": "Mail" },
            { "value": "phone", "label": "Phone" },
            { "value": "arrow", "label": "Arrow" },
            { "value": "wa", "label": "WhatsApp" },
            { "value": "pin", "label": "Pin" }
          ],
          "default": "mail"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "info@furnisquare.com"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "info": "Full URL, or path such as /pages/about-us. mailto: and tel: work too.",
          "default": "mailto:info@furnisquare.com"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in a new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Inner Press Band",
      "blocks": [
        { "type": "quick_link", "settings": { "icon": "mail", "label": "info@furnisquare.com", "link": "mailto:info@furnisquare.com" } },
        { "type": "quick_link", "settings": { "icon": "phone", "label": "+91-9785322576", "link": "tel:+919785322576" } },
        { "type": "quick_link", "settings": { "icon": "arrow", "label": "About Furnisquare", "link": "/pages/about-us" } }
      ]
    }
  ]
}
{% endschema %}
