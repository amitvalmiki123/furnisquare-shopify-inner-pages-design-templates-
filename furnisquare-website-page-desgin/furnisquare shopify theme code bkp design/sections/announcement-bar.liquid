              "label": "Pencil"
            },
            {
              "value": "boxes",
              "label": "Boxes"
            },
            {
              "value": "track",
              "label": "Track"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "card",
              "label": "Card"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "tag",
              "label": "Tag"
            },
            {
              "value": "mail",
              "label": "Mail"
            },
            {
              "value": "pin",
              "label": "Pin"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
