<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.c_dark }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {%- if settings.logo != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.logo | image_url: width: 64, height: 64 }}">
  {%- endif -%}

  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; tagged {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if template.name == 'product' and product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- elsif page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <style>
    :root {
      --saffron: {{ settings.c_accent }};
      --saffron-deep: {{ settings.c_accent_deep }};
      --ink: {{ settings.c_ink }};
      --espresso: {{ settings.c_dark }};
      --logo-h: {{ settings.logo_height }}px;
    }
    body.v2 { --band: {{ settings.c_band }}; }
  </style>

  {{ 'custom.css' | asset_url | stylesheet_tag }}
   {{ 'acustom.css' | asset_url | stylesheet_tag }}
  {{ 'quick-view.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.fs = {
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        search: {{ routes.search_url | json }},
        predictive: {{ routes.predictive_search_url | json }}
      },
      cartDrawer: {{ settings.cart_drawer | json }},
      onCartPage: {% if template.name == 'cart' %}true{% else %}false{% endif %},
      strings: {
        addToCart: {{ 'general.add_to_cart' | t | json }},
        adding: {{ 'general.adding' | t | json }},
        added: {{ 'general.added' | t | json }},
        soldOut: {{ 'general.sold_out' | t | json }},
        cartError: {{ 'cart.error_generic' | t | json }},
        readMore: {{ 'general.read_more' | t | json }},
        readLess: {{ 'general.read_less' | t | json }},
        newsletterOk: {{ 'newsletter.success' | t | json }},
        newsletterErr: {{ 'newsletter.error' | t | json }},
        wishlistOn: "Saved to your wishlist",
        wishlistOff: "Removed from your wishlist"
      }
    };
  </script>
  {% render 'script-loader' %}

  {{ content_for_header }}
</head>

<body class="v2 template-{{ template.name | handle }} page-{{ template.name | handle }}">
  {% render 'icon-sprite' %}
  <a class="skip" href="#main">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}
  {% sections 'overlay-group' %}
  
  {% render 'quick-view' %}
  {% render 'floating-actions' %}

  <div class="toast" role="status" aria-live="polite" hidden></div>

  <div class="vmodal" role="dialog" aria-modal="true" aria-label="Video player" hidden>
    <div class="vmodal__box">
      <button class="vmodal__close iconbtn" type="button" aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      <div class="vmodal__frame"></div>
    </div>
  </div>
</body>
</html>
