{%- comment -%}
  Inner page pull quote ("qband").
  Visual reference: mockup .qband — centred display type, saffron emphasis.
{%- endcomment -%}
<section class="sec qband" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="wrap">
    <blockquote>{{ section.settings.quote | replace: '</p><p>', ' ' | remove: '<p>' | remove: '</p>' }}</blockquote>
    {%- if section.settings.caption != blank -%}
      <p>{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Quote",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section label (accessibility)",
      "default": "Our belief"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "info": "Select the saffron word(s) and click the Italic (I) button — italic text renders in saffron.",
      "default": "<p>Take a few square feet of nothing, and transform it into something <em>beautiful.</em></p>"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "We want you to think of the setting up of a space as an energizing, creative pursuit — to breathe life into empty rooms with your ideas."
    }
  ],
  "presets": [
    {
      "name": "Inner Quote"
    }
  ]
}
{% endschema %}
