{%- liquid
  assign tel = settings.phone | replace: ' ', '' | replace: '-', ''
  assign base_menu = linklists[section.settings.base_menu]
-%}
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__news">
      <div>
        {%- if section.settings.nl_eyebrow != blank -%}
          <p class="eyebrow"><span class="sq" aria-hidden="true"></span>{{ section.settings.nl_eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.nl_heading }}</h2>
        <p>{{ section.settings.nl_text }}</p>
      </div>
      {%- form 'customer', class: 'ftr__form', data-newsletter: 'true', novalidate: 'novalidate' -%}
        <label class="sr-only" for="nl-email">{{ 'newsletter.label' | t }}</label>
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input id="nl-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required value="{{ form.email }}">
        <button class="btn btn--saffron" type="submit">{{ 'newsletter.subscribe' | t }} {% render 'icon', name: 'arrow' %}</button>
        <p class="ftr__msg" role="status" aria-live="polite">
          {%- if form.posted_successfully? -%}
            {{ 'newsletter.success' | t }}
          {%- elsif form.errors -%}
            {{ 'newsletter.error' | t }}
          {%- endif -%}
        </p>
      {%- endform -%}
    </div>

    <div class="ftr__grid">
      <div class="ftr__brand">
        <a class="ftr__logo" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 442 | image_tag: alt: shop.name, width: 221, height: 69, loading: 'lazy' }}
          {%- else -%}
            <span class="ftr__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.trust_text != blank -%}
          <p class="ftr__trust"><span aria-hidden="true">★</span> {{ section.settings.trust_text }}</p>
        {%- endif -%}
        <address>
          {{ settings.address }}<br>
          {%- if settings.phone != blank %}<a href="tel:{{ tel }}">{{ settings.phone }}</a>{% endif -%}
          {%- if settings.phone != blank and settings.email != blank %} · {% endif -%}
          {%- if settings.email != blank %}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a>{% endif -%}
        </address>
        <ul class="ftr__social" aria-label="Social media">
          {%- if settings.social_facebook != blank %}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{% endif -%}
          {%- if settings.social_instagram != blank %}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{% endif -%}
          {%- if settings.social_youtube != blank %}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a></li>{% endif -%}
          {%- if settings.social_linkedin != blank %}<li><a href="{{ settings.social_linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>{% endif -%}
          {%- if settings.social_pinterest != blank %}<li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a></li>{% endif -%}
          {%- if settings.social_google != blank %}<li><a href="{{ settings.social_google }}" target="_blank" rel="noopener">Google</a></li>{% endif -%}
          {%- if settings.social_threads != blank %}<li><a href="{{ settings.social_threads }}" target="_blank" rel="noopener">Threads</a></li>{% endif -%}
          {%- if settings.social_x != blank %}<li><a href="{{ settings.social_x }}" target="_blank" rel="noopener">X</a></li>{% endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <nav class="ftr__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            {%- for link in linklists[block.settings.menu].links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ftr__base">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- if base_menu.links.size > 0 -%}
        <p>
          {%- for link in base_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %} · {% endunless %}
          {%- endfor -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "nl_eyebrow",
      "label": "Eyebrow",
      "default": "Sign up for newsletter"
    },
    {
      "type": "text",
      "id": "nl_heading",
      "label": "Heading",
      "default": "Be the first to know."
    },
    {
      "type": "text",
      "id": "nl_text",
      "label": "Text",
      "default": "New designs, festive offers and care tips — straight to your inbox."
    },
    {
      "type": "header",
      "content": "Brand column"
    },
    {
      "type": "inline_richtext",
      "id": "trust_text",
      "label": "Trust line",
      "default": "Furnisquare is trusted by <strong>20K+</strong> satisfied customers"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "link_list",
      "id": "base_menu",
      "label": "Bottom links",
      "default": "footer"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Information"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu",
        "settings": {
          "heading": "Information",
          "menu": "footer-information"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "Category",
          "menu": "footer-category"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "Useful links",
          "menu": "footer-useful-links"
        }
      }
    ]
  }
}
{% endschema %}
