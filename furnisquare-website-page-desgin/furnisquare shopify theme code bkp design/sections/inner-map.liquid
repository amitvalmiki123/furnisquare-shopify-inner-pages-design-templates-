{%- comment -%}
  Inner page — “Find us” / visit us band. Left: heading + address + quick links.
  Right (or below): Google Maps embed. Quick-link blocks reuse the theme's .quick list.
  Visual reference: mockup .hm__visit in css/help-media.css.
{%- endcomment -%}
<section class="sec" aria-labelledby="map-{{ section.id }}">
  <div class="wrap hm__visit">
    <div>
      <h2 class="mast__title" id="map-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.address != blank -%}
        <address class="hm__addr">{{ section.settings.address | newline_to_br }}</address>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="quick">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{% render 'icon', name: block.settings.icon %}{{ block.settings.label }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if section.settings.map_src != blank -%}
      <div class="hm__map">
        <iframe title="{{ section.settings.map_title | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="{{ section.settings.map_src }}"></iframe>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Map / Visit",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H2)",
      "default": "Find us in Ratangarh"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address (one line per row)",
      "default": "Jangid Handicraft\nNear Sankat Mochan Balaji Temple, Jaipur Road,\nRatangarh, Churu (Rajasthan) 331022"
    },
    {
      "type": "text",
      "id": "map_src",
      "label": "Google Maps embed URL",
      "info": "The iframe embed src (Google Maps → Share → Embed a map).",
      "default": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1690.8949657376866!2d74.61738030364388!3d28.108074270281246!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3914bf06e69bf6af%3A0x1d3f65485582bf9a!2sFurnisquare%20Furniture!5e1!3m2!1sen!2sin!4v1750843727508!5m2!1sen!2sin"
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Map iframe title (accessibility)",
      "default": "Furnisquare on Google Maps"
    }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "pin", "label": "Pin" },
            { "value": "phone", "label": "Phone" },
            { "value": "mail", "label": "Mail" },
            { "value": "arrow", "label": "Arrow" },
            { "value": "wa", "label": "WhatsApp" },
            { "value": "track", "label": "Track" }
          ],
          "default": "pin"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Open in Google Maps"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "info": "Full URL, or path such as /pages/contact. tel: and mailto: work too.",
          "default": "https://www.google.com/maps/place/Furnisquare+Furniture/@28.1080188,74.6180805,18.75z"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in a new tab",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Inner Map / Visit",
      "blocks": [
        { "type": "quick_link", "settings": { "icon": "pin", "label": "Open in Google Maps", "link": "https://www.google.com/maps/place/Furnisquare+Furniture/@28.1080188,74.6180805,18.75z", "new_tab": true } },
        { "type": "quick_link", "settings": { "icon": "phone", "label": "+91-9785322576", "link": "tel:+919785322576", "new_tab": false } },
        { "type": "quick_link", "settings": { "icon": "mail", "label": "info@furnisquare.com", "link": "mailto:info@furnisquare.com", "new_tab": false } }
      ]
    }
  ]
}
{% endschema %}
