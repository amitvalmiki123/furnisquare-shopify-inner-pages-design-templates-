    "faq_949zwL": {
      "type": "faq",
      "blocks": {
        "qa_KCUNx7": {
          "type": "qa",
          "settings": {
            "question": "Is shipping free?",
            "answer": "<p>Yes. We ship all products for free. Delivery of any product is free of charge for all orders in India — we deliver across the country, except for a few non-serviceable PIN codes.</p>",
            "open": true
          }
        },
        "qa_G6D6Pc": {
          "type": "qa",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p><strong>Ready-to-Ship products</strong> are regularly stocked and typically delivered within 7–10 business days. <strong>Made-to-Order products</strong> are crafted specifically for you after the order is placed, so delivery may take 25–30 days.</p>",
            "open": false
          }
        },
        "qa_JRF6mt": {
          "type": "qa",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "<p>Yes — COD is available on Ready-to-Ship products that are currently in stock. Made-to-Order and custom products are manufactured after an order is received, so prepaid payment is required to confirm them. Prepaid orders also get an extra 10% off, applied automatically.</p>",
            "open": false
          }
        },
        "qa_zhhXzr": {
          "type": "qa",
          "settings": {
            "question": "What if something is damaged in transit?",
            "answer": "<p>All transit-related damage is totally our responsibility. Raise it with the delivery team and our customer support; if you notice an issue later, write to <a href=\"mailto:info@furnisquare.com\">info@furnisquare.com</a> within 24 hours of delivery with photos. We’ll assess it within 2 business days and repair or replace the product.</p>",
            "open": false
          }
        },
        "qa_NzDa49": {
          "type": "qa",
          "settings": {
            "question": "Is there a warranty?",
            "answer": "<p>Products come with a 36-month warranty against manufacturing defects and termites, for domestic use and when the care instructions are followed. Email photos with your order details and our team will contact you within 48 hours. <a href=\"/pages/warranty-care-instructions\" title=\"Warranty & Care Instructions\">Warranty & care</a></p>",
            "open": false
          }
        },
        "qa_6p7QdW": {
          "type": "qa",
          "settings": {
            "question": "Can I get a piece customised?",
            "answer": "<p>Yes. Design, colour, size and features can be tailored. Customised orders are fully prepaid, go into production as soon as details are confirmed (so they can’t be cancelled), and can take 5–7 weeks to dispatch. <a href=\"#\" title=\"#\">Customise order policy</a></p>",
            "open": false
          }
        },
        "qa_4nrmyc": {
          "type": "qa",
          "settings": {
            "question": "Do you take bulk orders?",
            "answer": "<p>Yes — for retailers, wholesalers, interior designers, architects, hotels, offices and distributors. Send a <a href=\"https://furnisquare.com/pages/bulk-order-customization\">bulk enquiry</a> and our team will contact you within 24 hours with a customised catalogue and quotation.</p>",
            "open": false
          }
        },
        "qa_RmFLcW": {
          "type": "qa",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>Sign in and visit the order tracking page, or use <a href=\"https://furnisquare.com/apps/track-shipment\">Track Shipment</a> as a guest with the email or phone number linked to your order. You’ll see order confirmation, manufacturing progress, quality check and dispatch details.</p>",
            "open": false
          }
        },
        "qa_TFhrDn": {
          "type": "qa",
          "settings": {
            "question": "Are there installation charges or hidden fees?",
            "answer": "<p>Absolutely not. Many pieces can be assembled using the instructions we provide; some heavier products may need a carpenter. Ask our delivery team to assemble where applicable so you know everything fits.</p>",
            "open": false
          }
        },
        "qa_9k66Le": {
          "type": "qa",
          "settings": {
            "question": "Will my furniture look exactly as shown?",
            "answer": "<p>We work hard to deliver every product as described. Solid wood is a natural material, though: grain patterns and slight stain differences make each piece unique, and are generally accepted on hardwood furniture.</p>",
            "open": false
          }
        }
      },
