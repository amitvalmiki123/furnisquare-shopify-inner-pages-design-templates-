{%- comment -%}
  Inner page collection tiles ("Popular for bulk orders"). Reuses the theme's
  .cat__* markup (custom.css) with the mockup's 5-up grid (acustom.css .bulkcols).
{%- endcomment -%}
{%- liquid
  assign title_id = 'collections-title-' | append: section.id
-%}
<section class="sec sec--tint" aria-labelledby="{{ title_id }}">
  <div class="wrap">
    <header class="shead">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"><span class="sq" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="mast__title" id="{{ title_id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </header>
    {%- if section.blocks.size > 0 -%}
      <ul class="bulkcols">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_collection = block.settings.collection
            assign tile_name = block.settings.name | default: tile_collection.title | default: 'Collection'
            assign tile_url = tile_collection.url | default: '#'
            assign tile_image = block.settings.image | default: tile_collection.featured_image
            assign tile_alt = block.settings.image_alt | default: tile_name
          -%}
          <li {{ block.shopify_attributes }}>
            <a class="cat__link" href="{{ tile_url }}">
              <span class="cat__media">
                {%- if tile_image != blank -%}
                  {{ tile_image | image_url: width: 600 | image_tag: alt: tile_alt, width: 600, height: 600, loading: 'lazy' }}
                {%- endif -%}
              </span>
              <span class="cat__name">{{ tile_name }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collections"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (H2)",
      "info": "Renders as <H2>…</H2>. Raw HTML field — tags are shown and saved exactly as typed. Wrap the saffron part in <em> tags, e.g. <em>bulk orders</em>.",
      "default": "Popular for <em>bulk orders</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Tile links to this collection. Leave Name / Image blank below to use the collection's title and featured image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional — leave blank to use the collection's featured image."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Optional — leave blank to use the collection title."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Optional — leave blank to use the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inner Collections"
    }
  ]
}
{% endschema %}
