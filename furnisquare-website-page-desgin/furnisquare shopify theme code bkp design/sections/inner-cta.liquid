{%- comment -%}
  Inner page closing call to action (espresso band).
  Visual reference: mockup .ctaband.
{%- endcomment -%}
<section class="sec" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="wrap">
    <div class="ctaband">
      <div>
        <h2>{{ section.settings.heading | replace: '</p><p>', ' ' | remove: '<p>' | remove: '</p>' }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="ctaband__acts">
          {%- if section.settings.button_1_label != blank -%}
            <a class="btn btn--saffron" href="{{ section.settings.button_1_link | default: '#' }}">{{ section.settings.button_1_label }} {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="btn btn--line" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inner CTA Band",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section label (accessibility)",
      "default": "Next steps"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Select the saffron word(s) and click the Italic (I) button — italic text renders in saffron.",
      "default": "<p>Start creating your <em>home</em></p>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": "Solid wood furniture for every room, delivered free across India."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "button_1_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "button_2_link",
      "label": "Secondary button link",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Inner CTA Band"
    }
  ]
}
{% endschema %}
