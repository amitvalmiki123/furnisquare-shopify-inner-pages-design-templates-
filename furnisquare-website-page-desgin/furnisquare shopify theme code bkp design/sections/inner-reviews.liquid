{%- comment -%}
  Inner page — reviews band. Left: heading + lede + optional button.
  Right: up to 3 review quotes (blocks). Visual reference: mockup .hm__rev / .hm__quotes.
{%- endcomment -%}
<section class="sec{% if section.settings.tinted %} sec--tint{% endif %}" aria-labelledby="rev-{{ section.id }}">
  <div class="wrap hm__rev">
    <div>
      <h2 class="mast__title" id="rev-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="hm__lede">{{ section.settings.lede }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--line" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="hm__quotes">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><blockquote><p>{{ block.settings.quote }}</p></blockquote><span>{{ block.settings.attribution }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Reviews",
  "settings": [
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Cream band background",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H2)",
      "default": "Let customers speak for us"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "334 reviews, 99% of them 5-star."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (optional)",
      "default": "Read all reviews"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/reviews"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Real good quality finish, clean and solid."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution",
          "default": "Wooden Half Round Console Table"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Inner Reviews",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Real good quality finish, clean and solid.", "attribution": "Wooden Half Round Console Table" } },
        { "type": "quote", "settings": { "quote": "Good wooden side table and perfect for the price. Happy with the product.", "attribution": "Sakshi Singh · Bedside Table with Drawers" } },
        { "type": "quote", "settings": { "quote": "Very nice, it looks the same as shown.", "attribution": "Solid Wood Choki Table" } }
      ]
    }
  ]
}
{% endschema %}
