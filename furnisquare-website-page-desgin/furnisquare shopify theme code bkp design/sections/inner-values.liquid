{%- comment -%}
  Inner page values cards ("Our values").
  Layout: 6-column grid, 3 cards per row. The last row is
  width-aware, so there is never a ragged gap:
    - last row of 2  → both cards span half the row (3 + 3)
    - last row of 1  → the card spans the full row (6)
  Icons come from the theme's built-in icon snippet.
{%- endcomment -%}
{%- liquid
  assign title_id = 'values-title-' | append: section.id
  assign total = section.blocks.size
  assign mod = total | modulo: 3
-%}
<section class="sec{% if section.settings.tinted %} sec--tint{% endif %}" aria-labelledby="{{ title_id }}">
  <div class="wrap">
    <header class="shead">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"><span class="sq" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="mast__title" id="{{ title_id }}">{{ section.settings.heading | replace: '</p><p>', ' ' | remove: '<p>' | remove: '</p>' }}</h2>
    </header>
    {%- if total > 0 -%}
      <ul class="cards">
        {%- for block in section.blocks -%}
          {%- liquid
            assign from_end = total | minus: forloop.index0
            assign fill = ''
            if mod == 2 and from_end <= 2
              assign fill = ' card--wide'
            elsif mod == 1 and from_end == 1
              assign fill = ' card--full'
            endif
          -%}
          <li class="card{{ fill }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
              <span class="card__ico">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}{% if block.settings.link_label != blank and block.settings.link_url != blank %} <a href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>{% endif %}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.notice != blank -%}
      <p class="notice">{% render 'icon', name: 'help' %}<span>{{ section.settings.notice }}</span></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inner Values",
  "settings": [
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Cream band background",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our values"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (H2)",
      "info": "Saffron = wrap text in <em>…</em>",
      "default": "What we <em>stand for</em>"
    },
    {
      "type": "html",
      "id": "notice",
      "label": "Notice (optional)",
      "info": "Shown as a banner below the cards. Raw HTML allowed, e.g. <a href>…</a>"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
