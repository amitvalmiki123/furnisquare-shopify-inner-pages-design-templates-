          "settings": {
            "icon": "leaf",
            "title": "Efficiency",
            "text": "We are here to build a long-term sustainable business. We aim to do more with less and focus on zero waste. We believe that a self-sustaining business will be responsible and solve customer problems in the right manner."
          }
        }
