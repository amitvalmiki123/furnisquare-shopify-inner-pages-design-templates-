{%- comment -%}
  Inner page FAQ (page.faq). Sidebar index (auto-built from the accordion),
  help box (phone + WhatsApp from theme settings), single-open accordion.
  Visual reference: mockup .faq / .faq__grid / .qa / .faqnav__list.
  FAQPage JSON-LD is emitted from the blocks.
{%- endcomment -%}
{%- liquid
  assign title_id = 'faq-list-title-' | append: section.id
-%}
<section class="sec faq" aria-labelledby="{{ title_id }}">
  <div class="wrap faq__grid">
    <aside class="faq__aside">
      <h2 class="faqnav__title" id="{{ title_id }}">{{ section.settings.aside_title }}</h2>
      <ol class="faqnav__list" data-faqnav></ol>
      <div class="faqnav__help">
        {%- if section.settings.help_text != blank -%}<p>{{ section.settings.help_text }}</p>{%- endif -%}
        <div class="faq__help">
          {%- if settings.phone != blank -%}
            {%- assign tel = settings.phone | replace: ' ', '' | replace: '-', '' -%}
            <a class="btn btn--ink" href="tel:{{ tel }}">{% render 'icon', name: 'phone' %}{{ settings.phone }}</a>
          {%- endif -%}
          {%- if settings.whatsapp != blank -%}
            <a class="btn btn--line" href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">{% render 'icon', name: 'wa' %}WhatsApp us</a>
          {%- endif -%}
        </div>
      </div>
    </aside>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="qa"{% if block.settings.open %} open{% endif %} id="faq-{{ block.id }}" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="qa__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(function() {
  var root = document.currentScript.closest('.faq');
  if (!root) return;
  var list = root.querySelector('.faq__list');
  var nav = root.querySelector('[data-faqnav]');
  var items = Array.prototype.slice.call(list.querySelectorAll('details.qa'));
  if (nav) {
    items.forEach(function(qa) {
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + qa.id;
      a.textContent = qa.querySelector('summary').textContent;
      a.addEventListener('click', function() { qa.open = true; });
      li.appendChild(a);
      nav.appendChild(li);
    });
    if (location.hash) {
      var target = items.filter(function(i) { return '#' + i.id === location.hash; })[0];
      if (target) target.open = true;
    }
  }
  items.forEach(function(item) {
    item.addEventListener('toggle', function() {
      if (item.open) {
        items.forEach(function(other) { if (other !== item) other.open = false; });
      }
    });
  });
})();
</script>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Inner FAQ",
  "settings": [
    {
      "type": "text",
      "id": "aside_title",
      "label": "Aside title (H2)",
      "default": "All questions"
    },
    {
      "type": "textarea",
      "id": "help_text",
      "label": "Help text",
      "info": "HTML allowed — e.g. <strong>…</strong>.",
      "default": "<strong>Still need help?</strong> Our team is a call or a WhatsApp away, 24/7."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently asked question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer text.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open on load",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inner FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Is Shipping Free?",
            "answer": "<p>Yes. We ship all products for free.</p>",
            "open": true
